# ---------- Database (MySQL / TiDB Cloud Serverless) ----------
# TiDB example: mysql://USER.root:PASSWORD@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/ho_helpdesk
# Local example: mysql://root:PASSWORD@localhost:3306/ho_helpdesk
DATABASE_URL=
# TiDB Cloud requires SSL (keep true). Set to false for a local MySQL server.
DB_SSL=true

# ---------- Private links ----------
# Share  https://<your-app>/supervisor?key=<SUPERVISOR_KEY>  with the supervisor
# and    https://<your-app>/admin?key=<ADMIN_KEY>            with HR & Admin.
# The key is remembered by the browser after the first visit.
# Leave empty only for local testing (pages are then open to anyone).
SUPERVISOR_KEY=
ADMIN_KEY=

# Names recorded automatically when a ticket is closed
SUPERVISOR_NAME=Housekeeping Supervisor
ADMIN_NAME=HR & Admin

# ---------- Email (Gmail: use an App Password, not the normal password) ----------
# If SMTP_USER / SMTP_PASS are empty, emails are only printed in the server log.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=HO Helpdesk <your.account@gmail.com>

# Public address of the app, used in email links (e.g. https://ho-helpdesk.vercel.app)
APP_URL=

# ---------- Photo storage ----------
# Created automatically when you connect a Vercel Blob store to the project.
# If empty, photos are saved to public/uploads (local testing only).
BLOB_READ_WRITE_TOKEN=
